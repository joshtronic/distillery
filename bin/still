#!/usr/bin/env bash
# bin/still -- the distillery's assembler.
#
#   still validate           check every skill against the format contract
#   still build              validate, then write dist/manifest.json + dist/index.md
#   still list               one line per skill (name -- description)
#   still index              render the README shelf block from frontmatter
#   still index --check      fail if the committed shelf block has drifted
#
# The format contract (deterministic; nothing reaches a consumer unchecked):
#   skills/<dir>/SKILL.md exists, opens with a YAML frontmatter block of flat
#   `key: value` lines containing name (== <dir>), description (nonempty),
#   consumers (from the closed list below), source, extracted -- and a
#   nonempty body after the closing delimiter. Unknown frontmatter keys fail.
#   Extra files ride in skills/<dir>/files/ and are listed in the manifest.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SKILLS_DIR="$ROOT/skills"
DIST_DIR="$ROOT/dist"
README="$ROOT/README.md"

FRONTMATTER_KEYS="name description consumers source extracted"
CONSUMERS_VOCAB="igor-surface generic"

SHELF_START='<!-- shelf:start -->'
SHELF_END='<!-- shelf:end -->'

fail() { printf 'still: %s\n' "$*" >&2; exit 1; }

# frontmatter <skill.md> -- echo the frontmatter lines (between the first two
# `---` delimiters); nonzero when the file doesn't open with a frontmatter.
frontmatter() {
  local f="$1"
  [ "$(head -1 "$f")" = "---" ] || return 1
  awk 'NR==1{next} /^---$/{exit} {print}' "$f"
}

# fm_get <frontmatter> <key> -- echo the trimmed value for <key>.
fm_get() {
  local fm="$1" key="$2" line
  line=$(grep -E "^${key}:" <<<"$fm" | head -1) || true
  [ -n "$line" ] || return 1
  sed -E 's/^[a-z-]+:[[:space:]]*//; s/[[:space:]]+$//' <<<"$line"
}

validate_skill() {
  local dir="$1" name f fm v k body_lines
  name="$(basename "$dir")"
  f="$dir/SKILL.md"
  [ -f "$f" ] || { echo "$name: missing SKILL.md"; return 1; }
  fm=$(frontmatter "$f") || { echo "$name: SKILL.md does not open with '---' frontmatter"; return 1; }
  # every required key present and nonempty
  for k in $FRONTMATTER_KEYS; do
    v=$(fm_get "$fm" "$k") || { echo "$name: frontmatter missing '$k'"; return 1; }
    [ -n "$v" ] || { echo "$name: frontmatter '$k' is empty"; return 1; }
  done
  # no unknown keys
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    k="${line%%:*}"
    grep -qw "$k" <<<"$FRONTMATTER_KEYS" || { echo "$name: unknown frontmatter key '$k'"; return 1; }
  done <<<"$fm"
  # name matches directory
  [ "$(fm_get "$fm" name)" = "$name" ] || { echo "$name: frontmatter name '$(fm_get "$fm" name)' != directory name"; return 1; }
  # consumers from the closed vocabulary (comma/space separated)
  for v in $(fm_get "$fm" consumers | tr ',' ' '); do
    grep -qw "$v" <<<"$CONSUMERS_VOCAB" || { echo "$name: consumer '$v' not in closed vocabulary ($CONSUMERS_VOCAB)"; return 1; }
  done
  # nonempty body after the frontmatter
  body_lines=$(awk 'c==2 && NF {n++} /^---$/{c++} END{print n+0}' "$f")
  [ "$body_lines" -gt 0 ] || { echo "$name: empty body after frontmatter"; return 1; }
  return 0
}

cmd_validate() {
  local rc=0 d
  [ -d "$SKILLS_DIR" ] || fail "no skills/ directory"
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    if ! validate_skill "${d%/}"; then rc=1; fi
  done
  [ "$rc" -eq 0 ] && echo "still: all skills valid"
  return "$rc"
}

# shelf_entries -- one "name<TAB>description" line per skill, sorted by name.
# Descriptions are copied verbatim from already-validated frontmatter.
shelf_entries() {
  local d name fm desc
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "${d%/}")"
    fm=$(frontmatter "$d/SKILL.md") || fail "index: $name: SKILL.md missing frontmatter"
    desc=$(fm_get "$fm" description) || fail "index: $name: frontmatter missing description"
    printf '%s\t%s\n' "$name" "$desc"
  done | sort -t "$(printf '\t')" -k1,1
}

# render_shelf_block -- the README shelf block content, one bullet per skill.
render_shelf_block() {
  shelf_entries | while IFS=$'\t' read -r name desc; do
    printf -- '- **%s** — %s\n' "$name" "$desc"
  done
}

# render_index_md -- dist/index.md content: a short header, then one linked
# bullet per skill.
render_index_md() {
  cat <<'HEADER'
# distillery skill index

Generated by `still build` from skills/*/SKILL.md frontmatter -- the
discovery surface for a consumer that has a proof but hasn't cloned the
tree. Do not hand-edit; run `still build` to regenerate.

HEADER
  shelf_entries | while IFS=$'\t' read -r name desc; do
    printf -- '- [%s](skills/%s/SKILL.md) — %s\n' "$name" "$name" "$desc"
  done
}

# find_shelf_markers -- locate the shelf:start/end marker pair in README.md.
# Sets SHELF_START_LINE / SHELF_END_LINE. A missing or unpaired marker pair
# is a hard failure, not a silent skip.
find_shelf_markers() {
  [ -f "$README" ] || fail "index: $README not found"
  local start_count end_count
  start_count=$(grep -c -F "$SHELF_START" "$README" || true)
  end_count=$(grep -c -F "$SHELF_END" "$README" || true)
  [ "$start_count" -eq 1 ] || fail "index: README.md must contain exactly one '$SHELF_START' marker (found $start_count)"
  [ "$end_count" -eq 1 ] || fail "index: README.md must contain exactly one '$SHELF_END' marker (found $end_count)"
  SHELF_START_LINE=$(grep -n -F "$SHELF_START" "$README" | cut -d: -f1)
  SHELF_END_LINE=$(grep -n -F "$SHELF_END" "$README" | cut -d: -f1)
  [ "$SHELF_START_LINE" -lt "$SHELF_END_LINE" ] || fail "index: README.md '$SHELF_START' marker must precede '$SHELF_END'"
}

# extract_shelf_block -- echo the currently committed lines between markers.
extract_shelf_block() {
  find_shelf_markers
  sed -n "$((SHELF_START_LINE+1)),$((SHELF_END_LINE-1))p" "$README"
}

# write_shelf_block -- overwrite the lines between markers with a fresh render.
write_shelf_block() {
  find_shelf_markers
  local tmp
  tmp="$(mktemp)"
  {
    sed -n "1,${SHELF_START_LINE}p" "$README"
    render_shelf_block
    sed -n "${SHELF_END_LINE},\$p" "$README"
  } > "$tmp"
  mv "$tmp" "$README"
}

# parse_shelf_block -- read rendered bullet lines from stdin, emit
# "name<TAB>description" for each.
parse_shelf_block() {
  local line
  while IFS= read -r line; do
    [[ "$line" =~ ^-\ \*\*([^*]+)\*\*\ —\ (.*)$ ]] || continue
    printf '%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  done
}

# report_stale_skills <old-block> <new-block> -- print a diff-style message
# to stderr naming which skills were added, removed, or changed.
report_stale_skills() {
  local old_block="$1" new_block="$2"
  local old_entries new_entries removed added removed_names added_names n
  old_entries=$(printf '%s\n' "$old_block" | parse_shelf_block)
  new_entries=$(printf '%s\n' "$new_block" | parse_shelf_block)
  removed=$(comm -23 <(sort <<<"$old_entries") <(sort <<<"$new_entries"))
  added=$(comm -13 <(sort <<<"$old_entries") <(sort <<<"$new_entries"))
  removed_names=$(cut -f1 <<<"$removed")
  added_names=$(cut -f1 <<<"$added")

  echo "still: shelf listing is stale in README.md:" >&2
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    if grep -qxF "$n" <<<"$added_names"; then
      echo "  ~ changed: $n" >&2
    else
      echo "  - removed: $n" >&2
    fi
  done <<<"$removed_names"
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    grep -qxF "$n" <<<"$removed_names" && continue
    echo "  + added:   $n" >&2
  done <<<"$added_names"
}

check_shelf_block() {
  find_shelf_markers
  local old new
  old=$(extract_shelf_block)
  new=$(render_shelf_block)
  if [ "$old" = "$new" ]; then
    echo "still: shelf listing is current"
    return 0
  fi
  report_stale_skills "$old" "$new"
  return 1
}

cmd_index() {
  cmd_validate >/dev/null || fail "index: validation failed -- nothing to render"
  case "${1:-}" in
    --check) check_shelf_block ;;
    "")      write_shelf_block; echo "still: wrote shelf listing to README.md" ;;
    *)       fail "usage: still index [--check]" ;;
  esac
}

cmd_build() {
  cmd_validate >/dev/null || fail "validation failed -- nothing ships unvalidated"
  mkdir -p "$DIST_DIR"
  local d name fm entries="" files sha
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    fm=$(frontmatter "$d/SKILL.md")
    sha=$(sha256sum "$d/SKILL.md" | cut -d' ' -f1)
    files=$(find "$d" -type f -not -name SKILL.md | sed "s|$ROOT/||" | sort | jq -R . | jq -sc .)
    entries+=$(jq -n \
      --arg name "$name" \
      --arg desc "$(fm_get "$fm" description)" \
      --arg consumers "$(fm_get "$fm" consumers)" \
      --arg path "skills/$name/SKILL.md" \
      --arg sha "$sha" \
      --argjson files "$files" \
      '{name:$name, description:$desc, consumers:($consumers|split(",")|map(gsub("^ +| +$";""))), path:$path, sha256:$sha, files:$files}')$'\n'
  done
  jq -sc '{skills: ., built_from: "still build"}' <<<"$entries" > "$DIST_DIR/manifest.json"
  render_index_md > "$DIST_DIR/index.md"
  echo "still: built $DIST_DIR/manifest.json ($(jq '.skills | length' "$DIST_DIR/manifest.json") skills)"
  echo "still: built $DIST_DIR/index.md"
}

cmd_list() {
  local d fm
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    fm=$(frontmatter "$d/SKILL.md" 2>/dev/null) || continue
    printf '%s -- %s\n' "$(basename "$d")" "$(fm_get "$fm" description)"
  done
}

case "${1:-}" in
  validate) cmd_validate ;;
  build)    cmd_build ;;
  list)     cmd_list ;;
  index)    cmd_index "${2:-}" ;;
  *) fail "usage: still validate|build|list|index [--check]" ;;
esac
